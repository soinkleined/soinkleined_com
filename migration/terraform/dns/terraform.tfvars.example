aws_region  = "us-east-1"
record_ttl   = 300

# Leave these at the defaults until Phase 7.
include_hostrocket_spf = true
include_cpanel_dkim    = true
dmarc_policy           = "quarantine"

# Fill from GitHub → Settings → Pages → the domain verification TXT.
# Verify against HostRocket first; these values must also be in this zone
# before the nameserver cutover or verification drops when NS changes.
github_pages_challenge = {
  "daveklein.com"    = ""
  "soinkleined.com" = ""
}

# Apex TXT values from the zone export other than SPF. Example:
# extra_apex_txt = {
#   "daveklein.com"    = ["google-site-verification=abcdef"]
#   "soinkleined.com" = []
# }

# caa_issuers = {
#   "daveklein.com"    = ["letsencrypt.org"]
#   "soinkleined.com" = ["letsencrypt.org"]
# }

# extra_records = {
#   "blog-daveklein" = {
#     zone    = "daveklein.com"
#     name    = "blog"
#     type    = "CNAME"
#     records = ["example.github.io"]
#   }
# }
