aws_region = "us-east-1"
record_ttl  = 300

# Leave these at the defaults until the HostRocket mail leftovers are gone.
include_hostrocket_spf = true
include_cpanel_dkim    = true
dmarc_policy           = "quarantine"

github_pages_challenge = ""

