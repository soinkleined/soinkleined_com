{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Route53ZonesAndRecords",
      "Effect": "Allow",
      "Action": [
        "route53:AssociateVPCWithHostedZone",
        "route53:ChangeResourceRecordSets",
        "route53:ChangeTagsForResource",
        "route53:DeleteHostedZone",
        "route53:DisassociateVPCFromHostedZone",
        "route53:GetChange",
        "route53:GetHostedZone",
        "route53:ListResourceRecordSets",
        "route53:ListTagsForResource",
        "route53:UpdateHostedZoneComment"
      ],
      "Resource": [
        "arn:aws:route53:::change/*",
        "arn:aws:route53:::hostedzone/*"
      ]
    },
    {
      "Sid": "Route53CreateHostedZone",
      "Effect": "Allow",
      "Action": [
        "route53:CreateHostedZone"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ListDnsState",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${bucket}",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "${state_prefix}/",
            "${state_prefix}/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadWriteDnsState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::${bucket}/${state_prefix}/*/terraform.tfstate"
    },
    {
      "Sid": "LockDnsState",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::${bucket}/${state_prefix}/*/terraform.tfstate.tflock"
    }
  ]
}
